    <diagram id="page2" name="2. Ciclo por barra (on_bar)">
        <mxGraphModel dx="793" dy="525" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1500" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p2-title" value="on_bar() — un ciclo completo por barra de 20 s" style="text;html=1;fontSize=18;fontStyle=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="600" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p2-bar" value="Llega &lt;b&gt;Bar&lt;/b&gt; (20-SECOND-MID)&lt;br&gt;close = bar.close.as_decimal()" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="380" y="70" width="250" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p2-fast" value="&lt;b&gt;1. fast_ma.update_raw(close)&lt;/b&gt;&lt;br&gt;d(t)=p(t)-p(t-1) → sign → N_fast(t)&lt;br&gt;value = media de los últimos N_fast precios" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="355" y="165" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p2-slow" value="&lt;b&gt;2. slow_ma.update_raw(close, k = N_fast)&lt;/b&gt;&lt;br&gt;según SLOW_WINDOW_MODE → N_slow(t)&lt;br&gt;value = media de los últimos N_slow precios" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="355" y="255" width="300" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p2-super" value="&lt;b&gt;3. super_slow_ma.update_raw(close, k = N_fast)&lt;/b&gt;&lt;br&gt;retardo iterado L niveles → N_super(t) ≈ 2&lt;sup&gt;L&lt;/sup&gt;·N_fast&lt;br&gt;value = media de los últimos N_super precios" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="355" y="340" width="300" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p2-note-order" value="&lt;b&gt;Las TRES se actualizan siempre&lt;/b&gt;, opere el par&lt;br&gt;que opere: así un solo CSV permite comparar&lt;br&gt;los tres emparejamientos offline.&lt;br&gt;&lt;br&gt;El orden importa: las dos lentas consumen la&lt;br&gt;ventana endógena que la rápida acaba de&lt;br&gt;calcular en esta misma barra (págs. 3, 5 y 6)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="700" y="180" width="290" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p2-trace" value="&lt;b&gt;4. _trace_indicators(bar)&lt;/b&gt;&lt;br&gt;traza las tres MAs; diff = faster - slower&#160;&lt;i&gt;(par elegido)&lt;/i&gt;&lt;br&gt;trend = CROSSED_UP / CROSSED_DOWN / no_cross&lt;br&gt;(comparando con _prev_diff)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="355" y="425" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p2-row" value="&lt;b&gt;5. Fila de auditoría&lt;/b&gt; (_new_audit_row)&lt;br&gt;timestamp, bar_price, &lt;b&gt;pair&lt;/b&gt;,&lt;br&gt;fast_ma/n_fast/runs_fast,&lt;br&gt;slow_ma/n_slow/runs_slow,&lt;br&gt;super_slow_ma/n_super_slow/runs_super_slow,&lt;br&gt;ma_diff, trend, position, PnL… → _audit_rows" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="355" y="525" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p2-ready" value="¿faster_ma.initialized&lt;br&gt;&lt;b&gt;y&lt;/b&gt; slower_ma.initialized?&lt;br&gt;&lt;i&gt;(solo las dos patas del par)&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
                    <mxGeometry x="385" y="655" width="240" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p2-return" value="&lt;b&gt;return&lt;/b&gt;&lt;br&gt;(calentamiento: la fila queda registrada&lt;br&gt;con las tres MAs, no se opera. Una MA&lt;br&gt;ajena al par no frena la ejecución)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="710" y="665" width="280" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p2-pos" value="net_position = portfolio.net_position(instrument)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="355" y="790" width="300" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="p2-buy" value="¿faster &gt; slower&lt;br&gt;y net_position ≤ 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="130" y="855" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p2-sell" value="¿faster &lt; slower&lt;br&gt;y net_position ≥ 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="680" y="855" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p2-hold" value="Sin cambio&lt;br&gt;(ya posicionado en el&lt;br&gt;lado correcto)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="410" y="845" width="190" height="60" as="geometry"/>
