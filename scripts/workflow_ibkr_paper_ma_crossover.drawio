                    <mxGeometry x="630" y="890" width="230" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p4-s4" value="4. &lt;b&gt;_write_audit_csv()&lt;/b&gt;&lt;br&gt;audit/audit_&amp;lt;strategy_id&amp;gt;_&amp;lt;ts&amp;gt;.csv" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="880" y="880" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p4-dispose" value="&lt;b&gt;finally: node.dispose()&lt;/b&gt;  — desconexión limpia" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="410" y="990" width="280" height="50" as="geometry"/>
