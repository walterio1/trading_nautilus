    <diagram id="page3" name="3. Ventana endógena N(t)">
        <mxGraphModel dx="933" dy="618" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p3-title" value="Medias móviles de ventana endógena — ninguna tiene parámetro de periodo" style="text;html=1;fontSize=18;fontStyle=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="800" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p3-price" value="Serie de precios de cierre&lt;br&gt;p(t) — &lt;b&gt;Decimal&lt;/b&gt; (“plano” es exactamente plano)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="430" y="70" width="330" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p3-fastbox" value="&lt;b&gt;RunLengthMovingAverage&lt;/b&gt; (rápida)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;spacingTop=6" parent="1" vertex="1">
                    <mxGeometry x="60" y="180" width="470" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="p3-f1" value="d(t) = p(t) - p(t-1)  &lt;i&gt;(incremento crudo)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="100" y="220" width="390" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p3-f2" value="sign(d(t)) ∈ { +1, -1, 0 }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="100" y="285" width="390" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="p3-f3" value="&lt;b&gt;RunLengthWindow&lt;/b&gt; → N_fast(t)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="100" y="345" width="390" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="p3-f4" value="value = media de los últimos &lt;b&gt;N_fast&lt;/b&gt; PRECIOS&lt;br&gt;initialized cuando N_fast queda definida" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="100" y="405" width="390" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="p3-slowbox" value="&lt;b&gt;SmoothedRunLengthMovingAverage&lt;/b&gt; (lenta)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;spacingTop=6" parent="1" vertex="1">
                    <mxGeometry x="660" y="180" width="470" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="p3-s1" value="k = N_fast(t)  &lt;i&gt;(la ventana de la rápida, no un parámetro)&lt;/i&gt;&lt;br&gt;s(t) = [p(t) - p(t-k)] / k  — momentum de k barras" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="700" y="215" width="390" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p3-s2" value="sign(s(t))  — filtro paso-bajo: solo cambia cuando&lt;br&gt;el movimiento sobre k barras cambia de dirección" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="700" y="285" width="390" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="p3-s3" value="&lt;b&gt;RunLengthWindow&lt;/b&gt; → N_slow(t)  (rachas más largas)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="700" y="345" width="390" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="p3-s4" value="value = media de los últimos &lt;b&gt;N_slow&lt;/b&gt; PRECIOS&lt;br&gt;&lt;i&gt;(precios, no incrementos: ambas MAs viven en&lt;br&gt;unidades de precio y el cruce tiene sentido)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="700" y="405" width="390" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p3-rlwbox" value="&lt;b&gt;RunLengthWindow.update(sign)&lt;/b&gt;  —  cómo nace N(t)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;spacingTop=6" parent="1" vertex="1">
                    <mxGeometry x="180" y="540" width="840" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="p3-w1" value="sign &gt; 0&lt;br&gt;cierra la racha bajista&lt;br&gt;run_up += 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="220" y="590" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p3-w2" value="sign &lt; 0&lt;br&gt;cierra la racha alcista&lt;br&gt;run_down += 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="490" y="590" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p3-w3" value="sign = 0&lt;br&gt;cierra ambas rachas&lt;br&gt;no abre ninguna" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="760" y="590" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p3-w4" value="¿existen ya prev_run_up &lt;b&gt;y&lt;/b&gt; prev_run_down?  (ready)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="400" y="695" width="400" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p3-w5" value="&lt;b&gt;N(t) = run_up + run_down + prev_run_up + prev_run_down&lt;/b&gt;&lt;br&gt;N ≥ 2 · tope MAX_ENDOGENOUS_WINDOW = 4096" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="380" y="800" width="440" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p3-w6" value="N = 0&lt;br&gt;(aún indefinida:&lt;br&gt;calentando)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="220" y="700" width="150" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p3-note" value="Idea: la ventana se estira mientras la racha&lt;br&gt;persiste y se contrae hacia la longitud de las&lt;br&gt;últimas rachas completadas cuando la dirección&lt;br&gt;se invierte. Ningún periodo fijado desde fuera." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="850" y="695" width="250" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p3-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="p3-price" target="p3-f1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="p3-price" target="p3-s1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="p3-f1" target="p3-f2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="p3-f2" target="p3-f3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
