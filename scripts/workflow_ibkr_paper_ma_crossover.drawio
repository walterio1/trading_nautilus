                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page5" name="5. Variante N_slow por auto-retardo">
        <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p5-title" value="Dos construcciones para N_slow — SLOW_WINDOW_MODE" style="text;html=1;fontSize=18;fontStyle=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="800" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p5-fast" value="&lt;b&gt;RunLengthMovingAverage&lt;/b&gt; (rápida) → &lt;b&gt;N_fast(t)&lt;/b&gt;&lt;br&gt;rachas de los incrementos crudos d(t)=p(t)-p(t-1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="380" y="70" width="420" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p5-switch" value="SLOW_WINDOW_MODE" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="470" y="165" width="240" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p5-a" value="&lt;b&gt;&quot;smoothed_runs&quot;&lt;/b&gt; — construcción actual&lt;br&gt;SmoothedRunLengthMovingAverage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;spacingTop=6" parent="1" vertex="1">
                    <mxGeometry x="60" y="300" width="480" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="p5-a1" value="k = N_fast(t)&lt;br&gt;s(t) = [p(t) - p(t-k)] / k" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="100" y="345" width="400" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p5-a2" value="sign(s(t)) → &lt;b&gt;segunda pasada de rachas&lt;/b&gt;&lt;br&gt;(RunLengthWindow sobre los signos suavizados)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="100" y="420" width="400" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="p5-a3" value="&lt;b&gt;N_slow = run_up+run_down+prev_up+prev_down&lt;/b&gt;&lt;br&gt;&lt;i&gt;más lenta que la rápida solo en distribución,&lt;br&gt;no garantizado barra a barra&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="100" y="500" width="400" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p5-b" value="&lt;b&gt;&quot;lagged_fast&quot;&lt;/b&gt; — variante por auto-retardo&lt;br&gt;LaggedWindowMovingAverage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;spacingTop=6" parent="1" vertex="1">
                    <mxGeometry x="640" y="300" width="500" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="p5-b1" value="historial de N_fast, un valor por barra&lt;br&gt;&lt;i&gt;(las barras de calentamiento entran como 0&lt;br&gt;para que el retardo se mida en barras)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="680" y="345" width="420" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p5-b2" value="retardo = N_fast(t)  →  hist[-1 - N_fast(t)]&lt;br&gt;&lt;i&gt;sin segunda pasada de rachas: O(1)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="680" y="430" width="420" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p5-b3" value="&lt;b&gt;N_slow(t) = N_fast(t) + N_fast(t - N_fast(t))&lt;/b&gt;&lt;br&gt;&lt;i&gt;N_fast ≥ 2 ⇒ N_slow ≥ N_fast + 2 &lt;b&gt;siempre&lt;/b&gt;&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="680" y="500" width="420" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p5-value" value="En ambos modos: &lt;b&gt;value = media de los últimos N_slow PRECIOS&lt;/b&gt;&lt;br&gt;(el cruce con la rápida sigue en unidades de precio)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="360" y="625" width="460" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p5-ex" value="&lt;b&gt;Ejemplo — historial N_fast: 8, 7, 6, 5, 6, 7, 5, 4&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontStyle=1;spacingTop=6" parent="1" vertex="1">
                    <mxGeometry x="240" y="730" width="700" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="p5-ex1" value="&lt;b&gt;barra actual&lt;/b&gt;  N_fast = 4&lt;br&gt;retrocedo 4 barras → N_fast era &lt;b&gt;5&lt;/b&gt;&lt;br&gt;&lt;b&gt;N_slow = 4 + 5 = 9&lt;/b&gt;" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=10">
                    <mxGeometry x="280" y="775" width="290" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p5-ex2" value="&lt;b&gt;barra anterior&lt;/b&gt;  N_fast = 5&lt;br&gt;retrocedo 5 barras → N_fast era &lt;b&gt;7&lt;/b&gt;&lt;br&gt;&lt;b&gt;N_slow = 5 + 7 = 12&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="610" y="775" width="290" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p5-guards" value="&lt;b&gt;Guardas&lt;/b&gt;: se salta la barra si N_fast=0 (rápida calentando), si el historial no llega tan atrás,&lt;br&gt;si el valor retardado era 0 (indefinido entonces), o si N_slow supera los precios en buffer / 4096" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="280" y="875" width="620" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="p5-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="p5-fast" target="p5-switch" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5-e2" value="rachas suavizadas" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="p5-switch" target="p5-a" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5-e3" value="auto-retardo" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="p5-switch" target="p5-b" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="p5-a1" target="p5-a2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="p5-a2" target="p5-a3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5-e6" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="p5-b1" target="p5-b2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5-e7" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="p5-b2" target="p5-b3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5-e8" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="p5-a3" target="p5-value" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5-e9" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="p5-b3" target="p5-value" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5-e10" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" parent="1" source="p5-b3" target="p5-ex" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page6" name="6. super_slow (retardo iterado)">
        <mxGraphModel dx="933" dy="618" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p6-title" value="&quot;super_slow&quot; — la misma regla iterada en cascada  (LaggedWindowMovingAverage, levels=L)" style="text;html=1;fontSize=18;fontStyle=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p6-rule" value="&lt;b&gt;N&lt;sub&gt;L&lt;/sub&gt;(t) = N&lt;sub&gt;L-1&lt;/sub&gt;(t) + N&lt;sub&gt;L-1&lt;/sub&gt;( t - N&lt;sub&gt;L-1&lt;/sub&gt;(t) )&lt;/b&gt;   con N&lt;sub&gt;0&lt;/sub&gt; = N_fast&lt;br&gt;cada nivel lee &lt;u&gt;su propia&lt;/u&gt; serie del nivel de abajo, con su propio retardo en barras" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13" parent="1" vertex="1">
                    <mxGeometry x="300" y="70" width="700" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p6-l0" value="&lt;b&gt;Nivel 0&lt;/b&gt;  N_fast(t)&lt;br&gt;rachas de los incrementos crudos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="80" y="200" width="300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p6-h0" value="historial nivel 0 (un valor por barra)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="440" y="190" width="170" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p6-l1" value="&lt;b&gt;Nivel 1&lt;/b&gt;  N₁ = N₀(t) + N₀(t-N₀(t))&lt;br&gt;≈ 2 × N_fast" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="80" y="320" width="300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p6-h1" value="historial nivel 1" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="440" y="315" width="170" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p6-l2" value="&lt;b&gt;Nivel 2&lt;/b&gt;  N₂ = N₁(t) + N₁(t-N₁(t))&lt;br&gt;≈ 4 × N_fast" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="80" y="440" width="300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p6-h2" value="historial nivel 2" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="440" y="435" width="170" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p6-ldots" value="⋮  (L niveles)" style="text;html=1;align=center;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="80" y="510" width="300" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p6-lL" value="&lt;b&gt;Nivel L = N_slow&lt;/b&gt; ≈ 2&lt;sup&gt;L&lt;/sup&gt; × N_fast&lt;br&gt;acotado por MAX_ENDOGENOUS_WINDOW = 4096" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=0" parent="1" vertex="1">
                    <mxGeometry x="80" y="560" width="300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p6-val" value="value = media de los últimos &lt;b&gt;N_slow&lt;/b&gt; PRECIOS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="80" y="670" width="300" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="p6-lag" value="&lt;b&gt;El retardo de cada nivel&lt;/b&gt;&lt;br&gt;&lt;br&gt;hist[-1]  = valor actual N&lt;sub&gt;L-1&lt;/sub&gt;(t)&lt;br&gt;hist[-1 - N&lt;sub&gt;L-1&lt;/sub&gt;(t)]  = el valor de hace N&lt;sub&gt;L-1&lt;/sub&gt;(t) barras&lt;br&gt;&lt;br&gt;Se anota &lt;b&gt;una entrada por barra en cada nivel&lt;/b&gt;,&lt;br&gt;incluidas las de calentamiento (valor 0), para&lt;br&gt;que el retardo siga midiéndose en barras y&lt;br&gt;los niveles no se desalineen entre sí." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="660" y="190" width="330" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="p6-guard" value="&lt;b&gt;Guardas por nivel&lt;/b&gt; (devuelven 0 = indefinido)&lt;br&gt;• el nivel de abajo aún vale 0&lt;br&gt;• el historial no llega N&lt;sub&gt;L-1&lt;/sub&gt;(t) barras atrás&lt;br&gt;• el valor retardado era 0 en aquel momento&lt;br&gt;• N_slow &gt; precios en buffer → se salta la barra" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="660" y="430" width="330" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p6-meas" value="&lt;b&gt;Medido sobre 4 000 barras simuladas&lt;/b&gt; (N medio / barra en que inicializa)&lt;br&gt;&lt;br&gt;smoothed_runs           8.9       bar 9&lt;br&gt;lagged_fast (L=1)      7.7       bar 7&lt;br&gt;super_slow L=2        15.0      bar 12&lt;br&gt;super_slow L=3        29.6      bar 31&lt;br&gt;super_slow L=4        58.9      bar 59&lt;br&gt;super_slow L=5       117.5     bar 120&lt;br&gt;&lt;br&gt;&lt;i&gt;La ventana duplica por nivel — y el calentamiento también.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontFamily=Courier New;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="440" y="590" width="550" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="p6-cfg" value="&lt;b&gt;SUPER_SLOW_LEVELS = 3&lt;/b&gt; &#8212; super_slow_ma es una MA propia, calculada en TODA barra (no un modo de SLOW_WINDOW_MODE)&lt;br&gt;La profundidad es un &lt;u&gt;número entero de niveles&lt;/u&gt;, no una longitud: sigue sin haber periodo exógeno.&lt;br&gt;Que llegue o no a operar lo decide &lt;b&gt;CROSSOVER_PAIR&lt;/b&gt; &#8212; página 7." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="80" y="850" width="910" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p6-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="p6-l0" target="p6-l1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="p6-l1" target="p6-l2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="p6-l2" target="p6-lL" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="p6-lL" target="p6-val" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6-e5" value="escribe" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" parent="1" source="p6-l0" target="p6-h0" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6-e6" value="lee con retardo N₀" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" parent="1" source="p6-h0" target="p6-l1" edge="1">
                    <mxGeometry x="0.7333" y="50" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p6-e7" value="escribe" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" parent="1" source="p6-l1" target="p6-h1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6-e8" value="lee con retardo N₁" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" parent="1" source="p6-h1" target="p6-l2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6-e9" value="escribe" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" parent="1" source="p6-l2" target="p6-h2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6-e10" value="lee con retardo N₂" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" parent="1" source="p6-h2" target="p6-lL" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page7" name="7. Tres MAs y par operado">
        <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p7-title" value="Tres MAs siempre calculadas &#8212; CROSSOVER_PAIR elige cu&#225;l par opera" style="text;html=1;fontSize=18;fontStyle=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p7-bar" value="close de la barra (Decimal)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="510" y="70" width="280" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="p7-fast" value="&lt;b&gt;fast_ma&lt;/b&gt;&lt;br&gt;RunLengthMovingAverage&lt;br&gt;rachas de los incrementos crudos&lt;br&gt;&#8594; &lt;b&gt;N_fast&lt;/b&gt;&#160; (&#8776; 4 en el test)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="80" y="170" width="330" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p7-slow" value="&lt;b&gt;slow_ma&lt;/b&gt;&#160; &#8212; SLOW_WINDOW_MODE&lt;br&gt;&quot;smoothed_runs&quot; (por defecto) &#183; &quot;lagged_fast&quot;&lt;br&gt;&#8594; &lt;b&gt;N_slow&lt;/b&gt;&#160; (&#8776; 9 en el test)&lt;br&gt;&lt;i&gt;p&#225;gina 5&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="480" y="170" width="330" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p7-super" value="&lt;b&gt;super_slow_ma&lt;/b&gt;&#160; &#8212; SUPER_SLOW_LEVELS = L&lt;br&gt;retardo iterado L niveles&lt;br&gt;&#8594; &lt;b&gt;N_super&lt;/b&gt; &#8776; 2&lt;sup&gt;L&lt;/sup&gt;&#183;N_fast&#160; (&#8776; 30 con L=3)&lt;br&gt;&lt;i&gt;p&#225;gina 6&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="880" y="170" width="340" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p7-note" value="Las tres se actualizan en TODA barra, en este orden: las dos lentas consumen N_fast de la misma barra.&lt;br&gt;Las tres se escriben en el CSV de auditor&#237;a &#8212; por eso un solo run permite comparar los tres pares offline." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1" parent="1" vertex="1">
                    <mxGeometry x="80" y="290" width="1140" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="p7-switch" value="&lt;b&gt;CROSSOVER_PAIR&lt;/b&gt;&lt;br&gt;(faster, slower)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
                    <mxGeometry x="530" y="390" width="240" height="100" as="geometry"/>
                </mxCell>
