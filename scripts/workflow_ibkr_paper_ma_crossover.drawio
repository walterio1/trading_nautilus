    <diagram id="page4" name="4. Eventos y parada">
        <mxGraphModel dx="1133" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p4-title" value="Ciclo de vida de órdenes/posiciones, auditoría y apagado" style="text;html=1;fontSize=18;fontStyle=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="700" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p4-ib" value="&lt;b&gt;IB (TWS paper)&lt;/b&gt; devuelve eventos" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="420" y="70" width="260" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p4-filled" value="&lt;b&gt;on_order_filled&lt;/b&gt;&lt;br&gt;log side/qty/px/commission&lt;br&gt;quita la fila de _pending_order_rows" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="60" y="180" width="270" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p4-rejected" value="&lt;b&gt;on_order_rejected&lt;/b&gt;&lt;br&gt;¿había fila pendiente?&lt;br&gt;sí → row[&quot;reject_reason&quot;] = motivo&lt;br&gt;no → nueva fila de auditoría con el motivo&lt;br&gt;&lt;i&gt;(así se ve un rechazo por falta de fondos)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="380" y="180" width="330" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="p4-canceled" value="&lt;b&gt;on_order_canceled&lt;/b&gt;&lt;br&gt;solo log" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="770" y="190" width="250" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p4-popen" value="&lt;b&gt;on_position_opened&lt;/b&gt;&lt;br&gt;side, qty, avg_px_open" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="60" y="330" width="270" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p4-pchanged" value="&lt;b&gt;on_position_changed&lt;/b&gt;&lt;br&gt;side, qty, realized/unrealized PnL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="380" y="330" width="330" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p4-pclosed" value="&lt;b&gt;on_position_closed&lt;/b&gt;&lt;br&gt;_last_trade_pnl = realized_pnl&lt;br&gt;_cumulative_realized_pnl += realized_pnl&lt;br&gt;añade fila POSITION_CLOSED (avg_open/avg_close)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="760" y="320" width="290" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="p4-rows" value="&lt;b&gt;_audit_rows&lt;/b&gt; (en memoria)&lt;br&gt;una fila por barra + filas por rechazo y por cierre de posición" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="400" y="450" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p4-hb" value="&lt;b&gt;_log_heartbeat&lt;/b&gt; cada 30 s&lt;br&gt;posición neta, unrealized/realized PnL,&lt;br&gt;estado de ambas MAs (valor y N, o “warming_up”),&lt;br&gt;balances de la cuenta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;dashed=1" parent="1" vertex="1">
                    <mxGeometry x="60" y="450" width="290" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p4-ctrlc" value="&lt;b&gt;Ctrl-C&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="450" y="610" width="200" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="p4-kbint" value="&lt;b&gt;except KeyboardInterrupt → node.stop()&lt;/b&gt;&lt;br&gt;&lt;i&gt;En Windows el manejador de señales de nautilus_trader&lt;br&gt;es un no-op (kernel._setup_loop() se salta), así que hay&lt;br&gt;que llamar a stop() explícitamente para que corra on_stop()&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="330" y="690" width="440" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="p4-onstop" value="&lt;b&gt;Strategy.on_stop()&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="450" y="810" width="200" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p4-s1" value="1. clock.cancel_timer(heartbeat)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="80" y="890" width="230" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p4-s2" value="2. &lt;b&gt;_flatten_position()&lt;/b&gt;&lt;br&gt;orden de mercado por |posición| redondeada" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="340" y="880" width="260" height="60" as="geometry"/>
